# =========================================================================
# Feishu / Lark App Credentials
# =========================================================================

# Complete official keys (Recommended)
FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================================================
# Access control
# -------------------------------------------------------------------------
# 指定管理员 Open ID（多个用英文逗号分隔，推荐直接配置）：
ADMIN_USERS=

# 允许访问的 open_id 或 chat_id（可选）：
ALLOWED_USERS=
ALLOWED_CHATS=

# =========================================================================
# Antigravity / agy engine
# =========================================================================

# agy 可执行文件路径（留空则自动检测，如 /root/.local/bin/agy 或 ~/.local/bin/agy）
ANTIGRAVITY_BIN=

# antigravity-cli 数据存储目录 (默认: ~/.gemini/antigravity-cli)
ANTIGRAVITY_HOME=

# 项目工作区根目录（留空则默认使用本项目所在根目录）
WORKSPACE_ROOT=

# 默认模型（通过 agy models 查看可用模型）
DEFAULT_MODEL=gemini-3.8-flash-high

# 是否向 agy 传递跳过权限确认标记 (默认 true，仅对管理员生效)
DANGEROUSLY_SKIP_PERMISSIONS=true
